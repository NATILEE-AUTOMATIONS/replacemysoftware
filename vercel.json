{
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/landscaping-software", "destination": "/landscaping-software.html" },
    { "source": "/hardscaping-estimating", "destination": "/hardscaping-estimating.html" },
    { "source": "/lawn-care-app", "destination": "/lawn-care-app.html" },
    { "source": "/irrigation-software", "destination": "/irrigation-software.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
